{
  "id": "tts",
  "version": "1.0.0",
  "entry": "./index.ts",
  "activation": "lazy",
  "display": {
    "name": "语音朗读",
    "description": "用系统或云端语音引擎朗读角色回复"
  },
  "permissions": [
    "seam.provide.tts.engine",
    "settings.section",
    "secrets.read.ttsCloudApiKey"
  ],
  "extensionPoints": {
    "provide": [
      "tts.engine"
    ],
    "settingsScope": [
      "ttsEnabled",
      "ttsAutoPlay",
      "ttsService",
      "ttsVoice",
      "ttsCloudProviderId",
      "ttsCloudBaseUrl",
      "ttsCloudModel",
      "ttsCloudVoice",
      "ttsCloudApiKey",
      "ttsCloudSpeed",
      "ttsRate",
      "ttsPitch",
      "ttsDialogueOnly",
      "ttsSkipActions",
      "ttsMaxChars"
    ],
    "settings": [
      {
        "id": "tts",
        "title": "语音设置"
      }
    ]
  }
}
